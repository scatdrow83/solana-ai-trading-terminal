# Copy to .env.production on the production host. Never commit the populated file.
DOMAIN=terminal.example.com
ACME_EMAIL=ops@example.com

# Supabase Settings > Database > Connection string > Session pooler (port 5432).
# Use a dedicated production project and URL-encode special characters in the password.
SUPABASE_DATABASE_URL=postgresql://terminal_app.PROJECT_REF:URL_ENCODED_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Generate unique secrets. APP_SECRET_KEY: openssl rand -hex 32
APP_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
REDIS_PASSWORD=replace-with-64-random-hex-characters
MARKET_DISCOVERY_TOKEN=replace-with-a-random-64-character-hex-token
MARKET_DISCOVERY_INTERVAL_MS=30000
ADMIN_EMAILS=admin@example.com
ADMIN_BOOTSTRAP_TOKEN=replace-with-64-random-hex-characters
JUPITER_API_KEY=replace-with-production-jupiter-api-key
# Use a paid/reliable RPC provider with suitable rate limits for live transactions.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
