{
  "name": "solana-terminal",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.6.2",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @solana-terminal/web --filter @solana-terminal/api --filter @solana-terminal/worker dev",
    "build": "pnpm --recursive build",
    "lint": "eslint .",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --filter @solana-terminal/risk-engine test"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@types/node": "22.13.10",
    "eslint": "9.22.0",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.1",
    "vitest": "3.0.8"
  }
}
