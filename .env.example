# Copy to .env when you are ready to run the project. Never commit .env.
NODE_ENV=development

# Application endpoints
WEB_PORT=3000
API_PORT=4000
WORKER_HEALTH_PORT=4001
NEXT_PUBLIC_API_URL=http://localhost:4000

# Local Supabase (started separately with the Supabase CLI)
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# External providers are intentionally unconfigured by default.
SOLANA_RPC_URL=
JUPITER_API_KEY=
AI_PROVIDER_API_KEY=

# Trading remains disabled; no signing implementation is included.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
