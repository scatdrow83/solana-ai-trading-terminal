# Local Docker staging settings. Copy this file to .env; never commit .env.
# All published service ports are bound to 127.0.0.1 by default.

# Local service ports
WEB_PORT=3000
API_PORT=4000
WORKER_HEALTH_PORT=4001

# Local PostgreSQL and Flask session settings
POSTGRES_DB=solana_terminal
POSTGRES_USER=solana_terminal
POSTGRES_PASSWORD=local-staging-change-this-password
APP_SECRET_KEY=local-staging-session-secret-change-before-deploy
SESSION_COOKIE_SECURE=false
LOCAL_SECURITY_SIMULATOR=true

# Optional integrations. Public market data works without either key.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_KEY=
# Compose constructs DATABASE_URL for the API from the PostgreSQL settings above.
